{
 "about": "Declarative contents of the package that release/assemble.py builds in this tree: the enabler-free build (variant intel-free-mfg; how it works: packaging/public/ARCHITECTURE.md). Each component maps package paths to sources: \"repo:<path>\" (a file of this tree), \"input:<lock group>/<file>\" (a file pinned in inputs.lock.json) and \"build:<kind>\", \"build:<kind>-record\", \"build:<kind>-profile/<file>\" (outputs of release/build_proxy.py and release/build_layer.py, and their build.json). Its add-on is payload/libxess_fg.dll, a proxy for Intel's unmodified XeFG runtime, which the installer downloads by its pinned hash (dependencies.json runtime.ProxyPackage); release/check_intel_free.py must report \"pass\" with no allowed component. Written by release/export_tree.py --public from the maintainers' package declaration; \"variants\" keeps the name intel-free-mfg for tools that pass --variant intel-free-mfg, and that entry changes nothing.",
 "name": "freefg-1.2.0",
 "variant": "intel-free-mfg",
 "documents_version": "public",
 "documents_component": "documents",
 "package_dir": "package-intel-free-mfg",
 "allowed_components": {},
 "manifest": {
  "runtime": "xemfg",
  "launcher_setup": "automatic",
  "profile": {
   "name": "cl-wino-q33-intel-free-mfg",
   "research": "this project's own shaders only, built from its HLSL sources (src/kernels), for the one-frame and multi-frame networks"
  },
  "default_factor": 2,
  "default_cap": "match output; optional generated-frame scaling is chosen in Settings",
  "fsr4": "4.1.1 RC12 INT8 (downloaded by the installer, see dependencies.json)",
  "enabler": "none: libxess_fg.dll proxy over Intel's unmodified XeFG runtime (bc250_xefg_original.dll, downloaded by the installer); another module that lifts Intel's frame limit is the user's own addition, never shipped",
  "status": "The public build. release/assemble.py writes its status text (PUBLIC_MANIFEST, with the product's name and version) into the manifest in place of this line.",
  "frame_start_pacing": {
   "research": "adaptive correction through the bundled OptiScaler XeLL output at 3x/4x; presentation pacing while XeFG generates, with the SDK output count controlling the MFG jitter allowance"
  },
  "enabler_overlay": "not applicable (no XeSSMFG enabler)",
  "optiscaler": {
   "source_commit": "25db192b1c1ebf42ae7cd6615bc6288b39121c5b",
   "upstream_base": "e7e3872d410f704479d94d318d68d163b6b58947",
   "fixed": [
    "f6db41dfa7bacb16ac50bd1e5787fdb44362da47 Try to prevent race conditions when hooking sl plugins (lock order: the loader lock before a Streamline plugin mutex)",
    "Separate XeSS, XeFG and XeLL library-path configuration fields (saved XeSSPath corruption)",
    "Adaptive FreeFG frame-start pacing through XeLL at 3x/4x, with bounded stall recovery",
    "Distinct HLX providers with original-input parameters and actual FFX provider identity"
   ]
  },
  "extras": {
   "extras/steam-screensaver-in-game": "optional user service: Steam idle screensaver off while a game runs, the user's timeout restored after",
   "extras/gamescope-cap-sys-nice": "optional pacman hook: gamescope keeps CAP_SYS_NICE"
  },
  "runtime_downloads": "Intel XeSS runtime (libxess_fg.dll, placed beside the proxy as bc250_xefg_original.dll; libxell.dll), the FSR4 DLL and OptiScaler's nightly support files are pinned in dependencies.json and fetched by the installer; this package does not contain them",
  "addon_entry": "libxess_fg-proxy",
  "max_factor": 2,
  "update_contract": {
   "format": 2,
   "layout": "game-local-xemfg-proxy",
   "configuration": 1
  }
 },
