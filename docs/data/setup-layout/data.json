{
 "figure": "setup-file-layout",
 "question": "What does Setup put into a game folder and its launcher entry, and what does Restore take back?",
 "example": {
  "game": "Echo Point Nova (Steam), frame-generation input OptiFG chosen by its recipe, 2026-10-19 (live install of 0.9.0; 1.0.0 places the same files plus five shaders, 1.1.0 seven more)",
  "executable_folder": "the folder of the game's rendering .exe"
 },
 "entries": [
  {
   "path": "dxgi.dll",
   "kind": "package",
   "what": "OptiScaler, this project's build of its 19 Oct 2026 master",
   "note": "an OptiScaler already in the game keeps its name (here winmm.dll)"
  },
  {
   "path": "OptiScaler.ini",
   "kind": "settings",
   "what": "OptiScaler's settings: frame generation on, its input, XeFG output through libxess_fg.dll"
  },
  {
   "path": "OptiScaler/",
   "kind": "download",
   "what": "OptiScaler's support files and OptiPatcher (12 files)",
   "note": "only when the game has no OptiScaler yet"
  },
  {
   "path": "OptiScaler/amd_fidelityfx_upscaler_dx12.dll",
   "kind": "download",
   "what": "FSR 4, a BC-250 build"
  },
  {
   "path": "libxess_fg.dll",
   "kind": "package",
   "what": "FreeFG: the proxy that runs its own shaders"
  },
  {
   "path": "bc250_xefg_original.dll",
   "kind": "download",
   "what": "Intel's XeFG runtime, unmodified"
  },
  {
   "path": "libxell.dll",
   "kind": "download",
   "what": "Intel's XeLL (latency), unmodified"
  },
  {
   "path": "nvngx_dlss.dll",
   "kind": "download",
   "what": "NVIDIA DLSS, for a DLSS input",
   "note": "only when OptiScaler finds no copy of the game's own"
  },
  {
   "path": "BC250-XeFG/layer/",
   "kind": "package",
   "what": "the pacing layer (Vulkan), 2 files"
  },
  {
   "path": "BC250-XeFG/shaders/",
   "kind": "package",
   "what": "40 own shaders and 9 small control files (1.1.0)"
  },
  {
   "path": "BC250-XeFG/settings.ini",
   "kind": "package",
   "what": "FreeFG's settings"
  },
  {
   "path": ".bc250-xefg-experimental/",
   "kind": "backup",
   "what": "the original of every file Setup replaces, the install record and the logs; Restore reads it",
   "note": "an existing OptiScaler/libxess_fg.dll and libxell.dll move in here (the runtime sits beside the game)"
  }
 ],
